{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cybershield-arch.local/schemas/architecture_sample.json",
  "title": "Cybersecurity Architecture Training Sample",
  "description": "Canonical schema for a single training sample in the CyberShield-Arch dataset. Aligned with the app contract: node types, edge labels, and security fields mirror backend/security and frontend/src/types.ts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "domain", "difficulty", "instruction", "architecture", "security", "metadata"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Unique sample identifier, e.g. 'banking-0001'."
    },
    "domain": {
      "type": "string",
      "enum": [
        "banking",
        "healthcare",
        "cybersecurity",
        "cloud",
        "iot",
        "e-commerce",
        "education",
        "smart-city",
        "logistics",
        "microservices",
        "devops",
        "ai-platform"
      ],
      "description": "Application domain covered by the sample."
    },
    "difficulty": {
      "type": "string",
      "enum": ["easy", "medium", "hard"],
      "description": "Generation difficulty tier: easy = 3-4 nodes, medium = 5-6 nodes, hard = 7-8 nodes."
    },
    "instruction": {
      "type": "string",
      "minLength": 20,
      "maxLength": 2000,
      "description": "The user-facing description that drives architecture generation. Matches the /explain input contract."
    },
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes", "edges"],
      "properties": {
        "nodes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "type"],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "description": "Node id; must be unique within the sample and referenced by edges. Spaces are allowed because the security engine matches control names as substrings (e.g. 'api gateway')."
              },
              "type": {
                "type": "string",
                "enum": ["ui", "service", "database", "cache", "queue", "container"],
                "description": "Allowed node types from backend/core/inference.py (_ALLOWED_NODE_TYPES)."
              }
            }
          }
        },
        "edges": {
          "type": "array",
          "minItems": 1,
          "maxItems": 15,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "target", "label"],
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1,
                "description": "Must reference an existing node id (enforced by the validator, not the schema)."
              },
              "target": {
                "type": "string",
                "minLength": 1,
                "description": "Must reference an existing node id (enforced by the validator, not the schema)."
              },
              "label": {
                "type": "string",
                "enum": ["HTTP", "DB Query", "Async", "Cache"],
                "description": "Allowed edge labels from backend/core/inference.py (_LABEL_ALIASES)."
              }
            }
          }
        }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_controls", "missing_controls", "threats", "recommendations", "risk_level", "security_score"],
      "properties": {
        "required_controls": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["Authentication", "RBAC", "API Gateway", "Audit Logging", "Monitoring", "Secrets Manager", "SIEM", "WAF", "IDS", "IPS", "Encryption Service", "MFA"]
          },
          "uniqueItems": true,
          "description": "Controls mandated for this domain/system by the security engine."
        },
        "missing_controls": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["Authentication", "RBAC", "API Gateway", "Audit Logging", "Monitoring", "Secrets Manager", "SIEM", "WAF", "IDS", "IPS", "Encryption Service", "MFA"]
          },
          "uniqueItems": true,
          "description": "Subset of required_controls absent from the architecture."
        },
        "threats": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "severity", "description"],
            "properties": {
              "name": {
                "type": "string",
                "enum": ["Unauthorized Access", "Privilege Escalation", "Credential Stuffing", "SQL Injection", "Data Leakage", "Data Tampering", "DDoS", "Session Hijacking", "Insider Threat", "Log Evasion", "Lateral Movement"]
              },
              "severity": {
                "type": "string",
                "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"]
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "missing_control": {
                "type": "string",
                "description": "The security control whose absence is responsible for this threat (mirrors the app's ThreatInfo)."
              }
            }
          },
          "description": "Threats inferred from missing controls (backend/security/threat_detector.py)."
        },
        "recommendations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Remediation steps, one per missing control."
        },
        "risk_level": {
          "type": "string",
          "enum": ["LOW", "MEDIUM", "HIGH"],
          "description": "Derived from security_score by the security engine."
        },
        "security_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "100 minus 20*critical, 10*high, 5*medium missing controls."
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "generated_by", "reviewed", "version"],
      "properties": {
        "source": {
          "type": "string",
          "enum": ["synthetic", "human", "model", "adapted"],
          "description": "Provenance of the instruction text."
        },
        "generated_by": {
          "type": "string",
          "description": "Generator identifier, e.g. 'gemma-3-4b', 'template-v1', 'human'."
        },
        "reviewed": {
          "type": "boolean",
          "description": "Set true only after human approval in review_dataset.py."
        },
        "version": {
          "type": "string",
          "description": "Dataset schema version, e.g. '1.0'."
        }
      }
    }
  }
}
